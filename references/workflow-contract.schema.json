{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor-toolkit.local/workflow-contract-v1.schema.json",
  "title": "Bounded local workflow contract v1",
  "description": "Structural validation only. Runtime hashes, provenance, arithmetic and approvals require toolkit_guard. Editable records are not authentication.",
  "oneOf": [
    {
      "$ref": "#/$defs/change_plan"
    },
    {
      "$ref": "#/$defs/workflow_state"
    },
    {
      "$ref": "#/$defs/pricing_evidence"
    },
    {
      "$ref": "#/$defs/receipt"
    }
  ],
  "$defs": {
    "approval": {"type": "object", "additionalProperties": false, "required": ["reviewer", "purpose", "digest"], "properties": {"reviewer": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "context": {"type": "object", "additionalProperties": false, "required": ["before", "after", "count"], "properties": {"before": {"type": "string"}, "after": {"type": "string"}, "count": {"type": "integer", "const": 1}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["path", "format", "before", "after", "before_sha256", "after_sha256", "selected_fields", "contexts"], "properties": {"path": {"type": "string", "minLength": 1}, "format": {"enum": ["json", "yaml", "markdown", "text"]}, "before": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "after": {"type": "string", "minLength": 1}, "before_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}, "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "selected_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}, "contexts": {"type": "array", "items": {"$ref": "#/$defs/context"}, "minItems": 1}}},
    "change_plan": {"oneOf": [{"$ref": "#/$defs/change_plan_v1"}, {"$ref": "#/$defs/change_plan_v2"}]},
    "change_plan_v1": {"type": "object", "additionalProperties": false, "required": ["schema_version", "kind", "operation_id", "root", "selected_sections", "targets", "approval"], "properties": {"schema_version": {"type": "integer", "const": 1}, "kind": {"const": "change_plan"}, "operation_id": {"type": "string", "minLength": 1}, "root": {"type": "string", "minLength": 1}, "selected_sections": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}, "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}, "minItems": 1}, "approval": {"anyOf": [{"$ref": "#/$defs/approval"}, {"type": "null"}]}}, "deprecated": true, "description": "Deprecated legacy field-key allowlist semantics; never interpret as human section labels."},
    "change_plan_v2": {"type": "object", "additionalProperties": false, "required": ["schema_version", "kind", "operation_id", "root", "selected_sections", "targets", "approval"], "properties": {"schema_version": {"type": "integer", "const": 2}, "kind": {"const": "change_plan"}, "operation_id": {"type": "string", "minLength": 1}, "root": {"type": "string", "minLength": 1}, "selected_sections": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}, "targets": {"type": "array", "items": {"$ref": "#/$defs/target_v2"}, "minItems": 1}, "approval": {"anyOf": [{"$ref": "#/$defs/approval"}, {"type": "null"}]}}},
    "target_v2": {"type": "object", "additionalProperties": false, "required": ["path", "format", "before", "after", "before_sha256", "after_sha256", "selected_fields", "contexts", "section"], "properties": {"path": {"type": "string", "minLength": 1}, "format": {"enum": ["json", "yaml", "markdown", "text"]}, "before": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "after": {"type": "string", "minLength": 1}, "before_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}, "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "selected_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}, "contexts": {"type": "array", "items": {"$ref": "#/$defs/context"}, "minItems": 1}, "section": {"type": "string", "minLength": 1}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "project_id", "path", "sha256", "revision", "date", "locator", "missing_reason"], "properties": {"id": {"type": "string", "minLength": 1}, "project_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "revision": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "date": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "locator": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "missing_reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}}},
    "quantity": {"type": "object", "additionalProperties": false, "required": ["id", "source_id", "unit", "rating"], "properties": {"id": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "rating": {"enum": ["A", "B", "C", "D"]}}},
    "price": {"type": "object", "additionalProperties": false, "required": ["id", "source_id", "unit", "currency", "source_type", "market", "base_rate", "locality", "escalation", "adjustment_basis", "confidence", "override", "override_reason", "disposition", "reviewer"], "properties": {"id": {"type": "string", "minLength": 1}, "source_id": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "unit": {"type": "string", "minLength": 1}, "currency": {"type": "string", "minLength": 1}, "source_type": {"enum": ["quote", "historical", "published", "assumption"]}, "market": {"type": "string", "minLength": 1}, "base_rate": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "locality": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "escalation": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "adjustment_basis": {"type": "string", "minLength": 1}, "confidence": {"type": "string", "minLength": 1}, "override": {"anyOf": [{"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, {"type": "null"}]}, "override_reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "disposition": {"enum": ["pending", "reviewed"]}, "reviewer": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}}},
    "line": {"type": "object", "additionalProperties": false, "required": ["id", "division", "quantity", "unit", "rate", "amount", "currency", "quantity_ref", "price_ref", "derivation", "allowance"], "properties": {"id": {"type": "string", "minLength": 1}, "division": {"type": "string", "minLength": 1}, "quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "unit": {"type": "string", "minLength": 1}, "rate": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "currency": {"type": "string", "minLength": 1}, "quantity_ref": {"type": "string", "minLength": 1}, "price_ref": {"type": "string", "minLength": 1}, "derivation": {"const": "quantity * rate"}, "allowance": {"type": "boolean"}}},
    "pricing_evidence": {"type": "object", "additionalProperties": false, "required": ["schema_version", "kind", "project_id", "revision", "quantity_evidence", "price_evidence", "lines", "division_totals", "subtotal", "markup_rate", "markup_basis", "fee", "total", "currency", "rounding", "quantum"], "properties": {"schema_version": {"type": "integer", "const": 1}, "kind": {"const": "pricing_evidence"}, "project_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "quantity_evidence": {"type": "array", "items": {"$ref": "#/$defs/quantity"}}, "price_evidence": {"type": "array", "items": {"$ref": "#/$defs/price"}}, "lines": {"type": "array", "items": {"$ref": "#/$defs/line"}}, "division_totals": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}}, "subtotal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "markup_rate": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "markup_basis": {"const": "subtotal"}, "fee": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "total": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "currency": {"type": "string", "minLength": 1}, "rounding": {"const": "ROUND_HALF_UP"}, "quantum": {"const": "0.01"}}},
    "phase": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"enum": ["complete", "pending", "not_applicable"]}, "reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "semantic_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "exception": {"type": "object", "additionalProperties": false, "required": ["id", "owner", "reason", "next_action"], "properties": {"id": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "next_action": {"type": "string", "minLength": 1}}},
    "workflow_state": {"type": "object", "additionalProperties": false, "required": ["schema_version", "kind", "root", "workflow_id", "project_id", "project_name", "revision", "stage", "status", "domain", "issuance", "sources", "scope", "scope_digest", "pricing_digest", "phases", "approvals", "artifacts", "exceptions", "next_safe_action"], "properties": {"schema_version": {"type": "integer", "const": 1}, "kind": {"const": "workflow_state"}, "root": {"type": "string", "minLength": 1}, "workflow_id": {"type": "string", "minLength": 1}, "project_id": {"type": "string", "minLength": 1}, "project_name": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "stage": {"enum": ["ROM", "conceptual", "formal"]}, "status": {"enum": ["draft", "needs_review", "needs_human", "approved_for_final", "final_verified"]}, "domain": {"enum": ["estimate", "contract", "incident-report", "sub-pay-app"]}, "issuance": {"const": "not_issued"}, "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}, "scope": {"type": "object", "additionalProperties": false, "required": ["description"], "properties": {"description": {"type": "string", "minLength": 1}}}, "scope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "pricing_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "phases": {"type": "object", "additionalProperties": false, "required": ["scope", "takeoff", "pricing", "artifact"], "properties": {"scope": {"$ref": "#/$defs/phase"}, "takeoff": {"$ref": "#/$defs/phase"}, "pricing": {"$ref": "#/$defs/phase"}, "artifact": {"$ref": "#/$defs/phase"}}}, "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}}, "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}, "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}}, "next_safe_action": {"enum": ["scope", "takeoff", "pricing", "artifact", "human_review"]}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["schema_version", "project_id", "revision", "path", "file_sha256", "semantic_sha256", "checker_version", "parser_version", "checks", "issuance", "inspection_gaps", "timestamp"], "properties": {"schema_version": {"type": "integer", "const": 1}, "project_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "checker_version": {"type": "string", "minLength": 1}, "parser_version": {"type": "string", "minLength": 1}, "checks": {"type": "object", "additionalProperties": false, "required": ["readback", "calculations"], "properties": {"readback": {"const": "passed"}, "calculations": {"enum": ["passed", "not_requested"]}}}, "issuance": {"const": "not_issued"}, "inspection_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}}, "timestamp": {"type": "string", "minLength": 1}}}
  }
}
